generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  city           String
  college        String?
  githubUrl      String?
  portfolioUrl   String?
  emailVerified  Boolean   @default(false)
  trustScore     Int       @default(50)
  skillValue     Int       @default(0)
  availability   Json?
  sessionsAsHost Session[] @relation("host")
  sessionsAsLearner Session[] @relation("learner")
  feedbackGiven  SessionFeedback[] @relation("feedbackAuthor")
  feedbackReceived SessionFeedback[] @relation("feedbackRecipient")
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]
  verificationTokens VerificationToken[]
  createdAt      DateTime  @default(now())

  @@index([city])
  @@index([skillValue])
}

model Session {
  id          String   @id @default(cuid())
  hostId      String
  learnerId   String
  startsAt    DateTime
  status      String   @default("scheduled")
  feedback    String?
  rating      Int?
  host        User     @relation("host", fields: [hostId], references: [id])
  learner     User     @relation("learner", fields: [learnerId], references: [id])
  feedbacks   SessionFeedback[]

  @@index([startsAt])
}

model SessionFeedback {
  id            String   @id @default(cuid())
  sessionId      String
  authorId       String
  recipientId    String
  rating         Int
  feedback       String
  createdAt      DateTime @default(now())
  session        Session  @relation(fields: [sessionId], references: [id])
  author         User     @relation("feedbackAuthor", fields: [authorId], references: [id])
  recipient      User     @relation("feedbackRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, rating])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model VerificationToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}
